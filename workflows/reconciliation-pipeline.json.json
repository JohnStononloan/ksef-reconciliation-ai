    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\n// Rekurencyjne szukanie wartości po kluczu w całym obiekcie\nfunction findValue(obj, targetKey) {\n  if (!obj || typeof obj !== 'object') return undefined;\n  if (Object.prototype.hasOwnProperty.call(obj, targetKey)) return obj[targetKey];\n\n  for (const key of Object.keys(obj)) {\n    if (typeof obj[key] === 'object') {\n      const res = findValue(obj[key], targetKey);\n      if (res !== undefined) return res;\n    }\n  }\n  return undefined;\n}\n\nconst parseNum = (val) => {\n  const num = parseFloat(val);\n  return isNaN(num) ? 0 : num;\n};\n\n// Ekstrakcja danych niezależnie od struktury XML/JSON\nconst podmiot1 = findValue(body, 'Podmiot1') || findValue(body, 'podmiot1') || {};\nconst podmiot2 = findValue(body, 'Podmiot2') || findValue(body, 'podmiot2') || {};\nconst fa = findValue(body, 'Fa') || findValue(body, 'fa') || {};\nconst platnosc = findValue(body, 'Platnosc') || findValue(body, 'platnosc') || {};\n\nconst daneP1 = findValue(podmiot1, 'DaneIdentyfikacyjne') || {};\nconst daneP2 = findValue(podmiot2, 'DaneIdentyfikacyjne') || {};\n\nreturn {\n  // Generowanie dynamicznego ID sesji na potrzeby MCP:\n  session_id: $execution.id ? `sess_${$execution.id}` : `sess_${Date.now()}`,\n\n  ksef_number: findValue(body, 'ksef_number') || \"\",\n  nr_faktury: findValue(fa, 'P_2') || findValue(body, 'P_2') || findValue(body, 'NumerFaktury') || \"BRAK_NUMERU\",\n  data_wystawienia: String(findValue(fa, 'P_1') || findValue(body, 'P_1') || findValue(body, 'DataWytworzeniaFa') || \"\").split('T')[0],\n  \n  nip_sprzedawcy: findValue(daneP1, 'NIP') || \"\",\n  nazwa_sprzedawcy: findValue(daneP1, 'Nazwa') || findValue(daneP1, 'PelnaNazwa') || \"\",\n  \n  nip_nabywcy: findValue(daneP2, 'NIP') || \"\",\n  nazwa_nabywcy: findValue(daneP2, 'Nazwa') || findValue(daneP2, 'PelnaNazwa') || \"\",\n  \n  kwota_netto: parseNum(findValue(fa, 'P_13_1') || findValue(fa, 'P_13_2') || 0),\n  kwota_vat: parseNum(findValue(fa, 'P_14_1') || findValue(fa, 'P_14_2') || 0),\n  kwota_brutto: parseNum(findValue(fa, 'P_15') || findValue(fa, 'P_11') || 0),\n  waluta: findValue(fa, 'KodWaluty') || \"PLN\",\n  \n  termin_platnosci: findValue(platnosc, 'Termin') || findValue(platnosc, 'DataZaplaty') || \"OPŁACONO\",\n  konto_bankowe: findValue(platnosc, 'NrRB') || \"BRAK\",\n  status_platnosci: findValue(platnosc, 'Zaplacono') === \"1\" ? \"OPŁACONA\" : \"NIEOPŁACONA\"\n};"
      },
