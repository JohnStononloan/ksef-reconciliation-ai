    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Klasyfikacja dopasowania przelew <-> faktura. Tolerancja groszowa: 0.02 PLN.\nconst TOLERANCJA = 0.02;\n\nconst clean = (v) => String(v === undefined || v === null ? '' : v).replace(/^=/, '').trim();\nconst digits = (v) => clean(v).replace(/\\D/g, '');\nconst toNumber = (v) => {\n  let s = clean(v).replace(/\\s/g, '').replace(/[^\\d,.\\-]/g, '');\n  if (s === '') return null;\n  if (s.indexOf(',') > -1 && s.indexOf('.') > -1) {\n    s = s.lastIndexOf(',') > s.lastIndexOf('.')\n      ? s.replace(/\\./g, '').replace(',', '.')\n      : s.replace(/,/g, '');\n  } else if (s.indexOf(',') > -1) {\n    s = s.replace(',', '.');\n  }\n  const n = parseFloat(s);\n  return isNaN(n) ? null : n;\n};\n\n// Faktura uznana za znalezioną tylko gdy Merge dołączył realny wiersz arkusza\nconst maFakture = clean($json.nr_faktury) !== ''\n  && $json.row_number !== undefined\n  && $json.row_number !== null;\n\nconst kwotaFakturyRaw = toNumber($json.kwota_brutto);\nconst kwotaFaktury = kwotaFakturyRaw === null ? null : Math.abs(kwotaFakturyRaw);\nconst kwotaPrzelewuRaw = toNumber($json.wyczyszczona_kwota);\nconst kwotaPrzelewu = kwotaPrzelewuRaw === null ? 0 : Math.abs(kwotaPrzelewuRaw);\n\nconst nipNabywcy = digits($json.nip_nabywcy);\nconst nipSprzedawcy = digits($json.nip_sprzedawcy);\nconst nipPrzelewu = digits($json[\"wyciągnięty_nip\"]);\n\n// Dopuszczamy zgodność z nabywcą LUB sprzedawcą - arkusz miesza faktury\n// sprzedażowe i kosztowe, kontrahent z wyciągu bywa po dowolnej stronie.\nlet nipStatus = 'ok';\nif (maFakture) {\n  if (nipPrzelewu === '') {\n    nipStatus = 'brak_danych';\n  } else if (nipPrzelewu !== nipNabywcy && nipPrzelewu !== nipSprzedawcy) {\n    nipStatus = 'niezgodny';\n  }\n}\n\nconst roznica = (maFakture && kwotaFaktury !== null)\n  ? Math.round((kwotaPrzelewu - kwotaFaktury) * 100) / 100\n  : null;\nconst kwotaZgodna = roznica !== null && Math.abs(roznica) <= TOLERANCJA;\nconst niedoplata = roznica !== null && roznica < -TOLERANCJA;\n\nlet powod = 'Dopasowano';\nif (!maFakture) {\n  powod = 'Brak faktury o numerze ' + clean($json.wyczyszczony_nr_faktury) + ' w arkuszu';\n} else if (nipStatus === 'brak_danych') {\n  powod = 'Nie wykryto NIP w danych przelewu - wymagana weryfikacja reczna';\n} else if (nipStatus === 'niezgodny') {\n  powod = 'NIP przelewu ' + nipPrzelewu + ' nie zgadza sie z NIP nabywcy (' + nipNabywcy + ') ani sprzedawcy (' + nipSprzedawcy + ')';\n} else if (kwotaZgodna) {\n  powod = 'Dopasowano, roznica ' + roznica + ' PLN (w tolerancji ' + TOLERANCJA + ')';\n} else if (niedoplata) {\n  powod = 'Niedoplata: przelew ' + kwotaPrzelewu + ' PLN vs faktura ' + kwotaFaktury + ' PLN, brakuje ' + Math.abs(roznica) + ' PLN';\n} else {\n  powod = 'Niezgodnosc kwot: przelew ' + kwotaPrzelewu + ' PLN vs faktura ' + kwotaFaktury + ' PLN, roznica ' + roznica + ' PLN';\n}\n\nreturn {\n  json: {\n    ...$json,\n    ma_fakture: maFakture,\n    kwota_faktury: kwotaFaktury,\n    kwota_przelewu: kwotaPrzelewu,\n    roznica_kwot: roznica,\n    kwota_zgodna: kwotaZgodna,\n    niedoplata: niedoplata,\n    nip_status: nipStatus,\n    nip_przelewu: nipPrzelewu,\n    nip_nabywcy_norm: nipNabywcy,\n    powod_klasyfikacji: powod,\n    execution_id: $execution.id\n  }\n};"
      },
