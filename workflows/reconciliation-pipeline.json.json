        "jsCode": "// Normalizacja pojedynczego przelewu z wyciągu CSV\nconst clean = (v) => String(v === undefined || v === null ? '' : v).replace(/^=/, '').trim();\n\n// 0. Data transakcji - odporne na BOM (\\uFEFF) w pierwszym nagłówku CSV oraz na inną wielkość liter w kluczu\nconst rawKeys = Object.keys($json);\nconst dataKey = rawKeys.find((k) => k.replace(/^\\uFEFF/, '').trim().toLowerCase() === 'data transakcji');\nconst dataTransakcji = clean(dataKey ? $json[dataKey] : ($json[\"Data transakcji\"] || $json.data_transakcji));\n\n// 1. Numer faktury z tytułu przelewu\nconst tytul = clean($json[\"Tytuł\"]);\nconst regexFaktury = /((?:K?FV|FZ)\\s*[\\d\\w\\/\\-]+|\\b\\d+\\/\\d+\\/\\d{4}\\b)/i;\nconst match = tytul.match(regexFaktury);\nconst numerFaktury = match ? match[0].trim() : tytul;\n\n// 2. Kwota - obsługa formatów \"1 234,56\", \"1,234.56\", \"-1234.56\"\nlet s = clean($json[\"Kwota transakcji\"]).replace(/\\s/g, '').replace(/[^\\d,.\\-]/g, '');\nif (s.indexOf(',') > -1 && s.indexOf('.') > -1) {\n  s = s.lastIndexOf(',') > s.lastIndexOf('.')\n    ? s.replace(/\\./g, '').replace(',', '.')\n    : s.replace(/,/g, '');\n} else if (s.indexOf(',') > -1) {\n  s = s.replace(',', '.');\n}\nconst parsed = parseFloat(s);\nconst kwotaLiczba = isNaN(parsed) ? 0 : Math.abs(parsed);\n\n// 3. NIP - akceptuje 1234567890, 123-456-32-18, PL1234567890.\n// Lookaround chroni przed wycięciem 10 cyfr ze środka numeru rachunku.\nconst zrodloNip = clean($json[\"Dane kontrahenta\"]) + ' ' + tytul;\nconst nipMatch = zrodloNip.match(/(?<!\\d)\\d{3}[-\\s]?\\d{3}[-\\s]?\\d{2}[-\\s]?\\d{2}(?!\\d)/);\nconst nip = nipMatch ? nipMatch[0].replace(/\\D/g, '') : '';\n\n// 4. Klucz złączenia (Merge) - identyczna normalizacja po obu stronach\nconst klucz = numerFaktury.toUpperCase().replace(/\\s+/g, '');\n\nreturn {\n  json: {\n    ...$json,\n    data_transakcji: dataTransakcji,\n    wyczyszczony_nr_faktury: numerFaktury,\n    wyczyszczona_kwota: kwotaLiczba,\n    \"wyciągnięty_nip\": nip,\n    klucz_faktury: klucz\n  }\n};"
      },
